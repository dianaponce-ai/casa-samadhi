# Casa Samadhi · copiá este archivo como .env y completalo. Nunca subas el .env a GitHub.
PORT=3001
PUBLIC_URL=https://www.casasamadhi.com.ar
SESSION_SECRET=una-frase-larga-y-secreta-de-al-menos-32-caracteres

# Primer usuario del panel (se crea solo si no hay ninguno)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mercado Pago (Tus integraciones → Credenciales de producción). Sin esto, los pagos son simulados.
MP_ACCESS_TOKEN=

# Emails (por ejemplo smtp://usuario:clave@smtp.servidor.com:587). Sin esto, quedan registrados en el panel.
SMTP_URL=
MAIL_FROM=Casa Samadhi <hola@casasamadhi.com.ar>
