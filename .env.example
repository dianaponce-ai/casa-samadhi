# Casa Samadhi · copiá este archivo como .env y completalo. Nunca subas el .env a GitHub.
PORT=3001

# Base de datos Postgres (Supabase, Neon…). En Vercel, al conectar Supabase se carga POSTGRES_URL sola.
# Sin esto se usa SQLite en DATA_DIR (servidor propio con disco).
DATABASE_URL=
# Opcional: certificado del servidor de la base, para verificarlo.
DATABASE_CA=
# Vercel: protege las tareas programadas (/api/cron).
CRON_SECRET=
PUBLIC_URL=https://www.casasamadhi.com.ar
SESSION_SECRET=una-frase-larga-y-secreta-de-al-menos-32-caracteres

# Primer usuario del panel (se crea solo si no hay ningún usuario de administración)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Contraseña inicial del web master (diana@nifty-agency.com), si todavía no tiene una. 10 caracteres o más.
# También puede elegirla con "¿Olvidaste tu contraseña?" o con: npm run create-admin -- diana@nifty-agency.com "contraseña" "Diana" webmaster
WEBMASTER_PASSWORD=

# Mercado Pago (Tus integraciones → Credenciales de producción). Sin esto, los pagos son simulados.
MP_ACCESS_TOKEN=

# Emails (por ejemplo smtp://usuario:clave@smtp.servidor.com:587). Sin esto, quedan registrados en el panel.
SMTP_URL=
MAIL_FROM=Casa Samadhi <hola@casasamadhi.com.ar>
