    "build:vercel": "node --disable-warning=ExperimentalWarning scripts/build-vercel.js",
    "demo-users": "node --disable-warning=ExperimentalWarning scripts/demo-users.js"
  },
  "dependencies": {
    "@vercel/functions": "3.11.3",
    "express": "^5.1.0",
    "nodemailer": "6.10.1",
    "pg": "8.23.1"
