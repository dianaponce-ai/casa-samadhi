{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/vercel",
  "cleanUrls": true,
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api?__route=uploads/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "17 11 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/turnos/",
      "destination": "/turnos",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
